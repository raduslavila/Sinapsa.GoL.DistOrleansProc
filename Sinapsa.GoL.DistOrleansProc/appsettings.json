{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ClusterConfig": {
    "UseLocalhost": true,
    "UseKubernetesHosting": false,
    "UseDashboard": true,
    "DashboardPort": 8000,
    "DashboardPath": "dashboard",
    "UseLinuxStatistics": false,
    "ClusterOptions": {
      "ClusterId": "dev-GoL",
      "ServiceId": "dev-GoL-one"
    },
    "ClusterEndpointOptions": {
      "SiloPort": 30000,
      "GatewayPort": 11111
    }
  },
  "UseMemoryGrainStorage": true
}
